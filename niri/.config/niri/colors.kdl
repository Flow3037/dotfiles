layout {
	background-color "#121318"

    focus-ring {
        active-color "#c1c6dd"
        inactive-color "#8f909a"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#b3c5ff"
        inactive-color "#8f909a"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b3c5ff"
        inactive-color "#121318e6"
        urgent-color   "#ffb4ab"
    }
    insert-hint {
        color "#b3c5ff80"
    }
}
overview {
	backdrop-color "#121318"
}

recent-windows {
    highlight {
        active-color "#b3c5ff"
        urgent-color "#ffb4ab"
    }
}

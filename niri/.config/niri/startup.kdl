spawn-at-startup "awww-daemon"
spawn-sh-at-startup "sleep 1 && awww img \"$(cat ~/.config/wallpaper 2>/dev/null)\""
spawn-at-startup "waybar"
spawn-at-startup "dunst"
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-sh-at-startup "~/.local/bin/sleep.sh"
spawn-sh-at-startup "~/.local/bin/media.sh"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-sh-at-startup "gammastep -l -33.8:151.0 -t 6500:3500"
spawn-at-startup "/usr/lib/pam_kwallet_init"

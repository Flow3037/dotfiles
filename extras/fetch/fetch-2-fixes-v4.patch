+      double fre = (double)m.f_bfree * m.f_frsize;
+      double use = tot - fre;
+      int p = (int)(use * 100 / tot);
+      const char *c = p >= 80 ? "31" : p >= 50 ? "93" : "32";
+      const double GiB = 1024.0 * 1024 * 1024, TiB = GiB * 1024;
+      char label[160];
+      snprintf(label, sizeof(label), "Disk (%s)", mnt);
+      if (tot >= TiB)
+        add_info(label, "%.2f TiB / %.2f TiB (\033[%sm%d%%\033[0m) - %s",

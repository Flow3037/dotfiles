 #else
-  // Get filesystem type from /proc/mounts
-  char fstype[32] = "";
-  FILE *fp = fopen("/proc/mounts", "r");
-  if (fp) {
+  // Root first, then any real drives mounted under /mnt, /media or /run/media
+  (void)total_gib; (void)used_gib; (void)pct; (void)color;
+  const char *prefixes[] = {"/", "/mnt/", "/media/", "/run/media/"};
+  for (int pass = 0; pass < 2; pass++) {
+    FILE *fp = fopen("/proc/mounts", "r");
+    if (!fp)
+      return;
     char buf[512];
     while (fgets(buf, sizeof(buf), fp)) {
-      // Format: device mountpoint fstype options ...
       char dev[128], mnt[128], fs[32];
-      if (sscanf(buf, "%127s %127s %31s", dev, mnt, fs) == 3) {
-        if (strcmp(mnt, "/") == 0) {
-          strncpy(fstype, fs, sizeof(fstype) - 1);
-          break;
-        }
+      if (sscanf(buf, "%127s %127s %31s", dev, mnt, fs) != 3)
+        continue;
+      int is_root = strcmp(mnt, "/") == 0;
+      if (pass == 0 && !is_root)
+        continue;
+      if (pass == 1) {
+        if (is_root || strncmp(dev, "/dev/", 5) != 0)
+          continue;
+        int match = 0;

{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,
    "margin-top": 0,
    "margin-bottom": 0,
    "modules-left": [
        "niri/workspaces",
        "mpris"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "temperature",
        "memory",
        "pulseaudio",
        "network",
        "tray",
        "custom/dunst"
    ],
    "niri/workspaces": {
        "on-click": "activate",
        "all-outputs": false,
        "format": "{index}"
    },
    "mpris": {
        "format": " {title} - {artist}",
        "format-paused": " <i>{title} - {artist}</i>",
        "max-length": 40,
        "tooltip": false
    },
    "clock": {
        "format": "  {:%A, %d %B %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 3,
        "on-click": "kitty -e btop",
        "tooltip": false
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": " {temperatureC}°C"
    },
    "memory": {
        "format": " {used:0.1f}GiB",
        "interval": 5,
        "tooltip": false
    },
    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": " muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "network": {
        "format-ethernet": "",
        "format-wifi": "",
        "format-disconnected": "",
        "tooltip-format": "{ifname}  {ipaddr}"
    },
    "tray": {
        "spacing": 6
    },
    "custom/dunst": {
        "format": "{}",
        "exec": "dunstctl is-paused | grep -q true && echo 'DND' || echo ''",
        "interval": "once",
        "signal": 8
    }
}

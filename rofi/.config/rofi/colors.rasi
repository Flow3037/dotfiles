* {
    primary: #a9bdff;
    primary-fixed: #dbe1ff;
    primary-fixed-dim: #b3c5ff;
    on-primary: #172c5f;
    on-primary-fixed: #001849;
    on-primary-fixed-variant: #314578;
    primary-container: #3d5084;
    on-primary-container: #ffffff;
    secondary: #c1c6dd;
    secondary-fixed: #dde2f9;
    secondary-fixed-dim: rgba(230, 236, 255, 0.8);
    on-secondary: #292e40;
    on-secondary-fixed: #151b2c;
    on-secondary-fixed-variant: #414659;
    secondary-container: #4c5165;
    on-secondary-container: #ffffff;
    tertiary: #e1bbdc;
    tertiary-fixed: #ffd6f9;
    tertiary-fixed-dim: #e1bbdc;
    on-tertiary: #40263f;
    on-tertiary-fixed: #2b122b;
    on-tertiary-fixed-variant: #5a3d58;
    tertiary-container: #664864;
    on-tertiary-container: #ffffff;
    error: #ffb4ab;
    on-error: #660004;
    error-container: #a7060f;
    on-error-container: #ffffff;
    surface: #121318;
    on-surface: #e3e2e9;
    on-surface-variant: #c5c6d0;
    outline: #8f909a;
    outline-variant: #50515a;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e3e2e9;
    inverse-on-surface: #2f3036;
    inverse-primary: #4a5c92;
    surface-dim: #15161cCC;
    surface-bright: #3a3b41;
    surface-container-lowest: #0b0d12;
    surface-container-low: #1b1c21;
    surface-container: #202126;
    surface-container-high: #2a2b31;
    surface-container-highest: #35363c;
}
